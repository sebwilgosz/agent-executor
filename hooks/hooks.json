{
  "description": "Executor: whenever Claude creates a pull request, assign it to its author (plain shell, detached) and start a code review. With heavy.json in place, heavy Bash commands take turns for a machine-wide slot.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/heavy-hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__.*__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/assign-author.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/review-new-pr.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.ts"
  ]
}
